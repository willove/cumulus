# Per-suite LLM endpoint config (gitignored — credentials never enter the
# repository). Copy to .env and fill in. LLM_* keys are canonical;
# environment variables already set always win. Legacy names (AIGATE_*,
# LLM_MODEL_NAME) still work — they alias onto LLM_* when the canonical
# key is unset.
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=MiniMax-M3

# Optional overrides:
# LLM_REASONING_SPLIT=1   # force MiniMax reasoning_split (auto on minimaxi.com)
# LLM_EMBED_MODEL=        # remote embedder model; unset = local seat
#                          (minilm weights when present, else hash-64)
