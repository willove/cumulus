# Per-suite LLM endpoint config (gitignored — credentials never enter the
# repository). Copy to .env and fill in; LLM_* keys alias onto the suite's
# AIGATE_* variables, and environment variables already set always win.
# Same convention as ~/.sirchmunk/.env, so one operator habit covers both.
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=MiniMax-M3

# Optional overrides:
# AIGATE_REASONING_SPLIT=1   # force MiniMax reasoning_split (auto on minimaxi.com)
# AIGATE_EMBED_MODEL=        # unset: offline embedder (gateway has chat only)
